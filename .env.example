# 서버 주소 (LAN 에서 접속하려면 0.0.0.0)
KITCHEN_BIND=0.0.0.0:8080
# DB(kitchen.db)와 사진(photos/)이 저장될 곳
KITCHEN_DATA_DIR=./data
# 설정하면 로그인 필요. 비우면 인증 없음 (LAN/VPN 전용일 때)
KITCHEN_PASSWORD=
# 알림 클릭 시 열 주소
KITCHEN_PUBLIC_URL=http://172.30.1.25:8080
# 시간대 (KST = 9)
KITCHEN_TZ_OFFSET_HOURS=9

# ntfy — 토픽을 비우면 알림 꺼짐. 토픽 이름은 추측하기 어렵게!
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# 매일 몇 시에 알릴지, 유통기한 며칠 전부터 알릴지
NOTIFY_HOUR=9
EXPIRY_WARN_DAYS=3

RUST_LOG=info,sqlx=warn
